<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/relativeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginVertical="10dp">
                <TextView
                    android:id="@+id/eventText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find events in"
                    android:fontFamily="@font/unineue_trial_regular"
                    android:textSize="12sp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:textColor="#410472"/>
                <RelativeLayout
                    android:id="@+id/cityLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/eventText"
                    android:layout_marginVertical="5dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:id="@+id/city"

                        >

                        <Spinner
                            android:id="@+id/spinner_city"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            ></Spinner>

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/down_arrow"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/down_arrow"
                        android:layout_toRightOf="@id/city"
                        android:layout_centerVertical="true"
                        />
                </RelativeLayout>
                <View
                    android:id="@+id/view"
                    android:layout_width="100dp"
                    android:layout_height="1dp"
                    android:background="#4A4A4A"
                    android:layout_below="@id/cityLayout"/>
                <RelativeLayout
                    android:id="@+id/viewEventLayout"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/img_7"
                    android:layout_below="@id/view"
                    android:layout_marginTop="25dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View all events on the map"
                        android:textColor="#290347"
                        android:textSize="14dp"
                        android:fontFamily="@font/unineue_trial_regular"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="30dp"/>
                    <RelativeLayout
                        android:layout_width="70dp"
                        android:layout_height="40dp"
                        android:background="@drawable/img_8"
                        android:layout_alignParentEnd="true">
                        <ImageView
                            android:layout_width="12sp"
                            android:layout_height="12sp"
                            android:src="@drawable/right_arrow"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                </RelativeLayout>
                <TextView
                    android:id="@+id/even_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Events"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:fontFamily="@font/unineue_trial_bold"

                    android:layout_below="@id/viewEventLayout"
                    android:layout_marginTop="25dp"/>
                <TextView
                    android:id="@+id/happyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Happening today"
                    android:textColor="#FE4164"
                    android:textSize="15sp"
                    android:fontFamily="@font/unineue_trial_bold"

                    android:layout_below="@id/even_view"
                    android:textFontWeight="450"/>
                <ImageView
                    android:id="@+id/round_img"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/round_img"
                    android:layout_alignEnd="@id/happyText"
                    android:layout_alignBottom="@id/happyText"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/round_img"

                    android:orientation="vertical"
                    >
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_events"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"></androidx.recyclerview.widget.RecyclerView>
                </LinearLayout>


            </RelativeLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/companyCart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/relativeLayout">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/happyLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:layout_marginHorizontal="15dp"
                        >

                        <TextView
                            android:id="@+id/even_view2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/unineue_trial_bold"
                            android:text="Events"
                            android:textColor="#000000"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/happyText2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Events Corporate Organizers"
                            android:textColor="#FE4164"
                            android:textSize="15sp"
                            android:layout_below="@id/even_view2"
                            android:fontFamily="@font/unineue_trial_bold"
                            android:textFontWeight="450"/>
                        <ImageView
                            android:id="@+id/round_img2"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/round_img"
                            android:layout_alignEnd="@id/happyText2"
                            android:layout_alignBottom="@id/happyText2"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:id="@+id/companyLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/happyLayout"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:layout_marginStart="12dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_organizer_list"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"></androidx.recyclerview.widget.RecyclerView>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="@dimen/_5sdp"
                            >
                            <RelativeLayout
                                android:id="@+id/seeAll"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="@dimen/_60sdp"
                                android:background="@drawable/see_all"
                                android:layout_marginStart="10dp">

                                <ImageView
                                    android:id="@+id/ivNextOrganizeList"
                                    android:layout_width="16dp"
                                    android:layout_height="18dp"
                                    android:layout_centerInParent="true"
                                    android:src="@drawable/right_arrow" />
                            </RelativeLayout>
                            <TextView
                                android:id="@+id/text4"
                                android:layout_width="64dp"
                                android:layout_height="wrap_content"
                                android:text="See All"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:textColor="@color/heading_color"
                                android:textSize="@dimen/_12sdp"
                                android:fontFamily="@font/unineue_trial_regular"
                                android:layout_marginStart="17dp"
                                android:gravity="center"/>
                        </LinearLayout>


                    </LinearLayout>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <RelativeLayout
                android:id="@+id/relativeLayout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/companyCart"
                android:layout_marginHorizontal="12dp"
               >
                <TextView
                    android:id="@+id/even_view4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Events"
                    android:textColor="#000000"
                    android:fontFamily="@font/unineue_trial_bold"
                    android:textSize="15sp"
                    android:layout_marginTop="10sp"
                    />
                <TextView
                    android:id="@+id/happyText5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Events"
                    android:textColor="#FE4164"
                    android:textSize="15sp"
                    android:fontFamily="@font/unineue_trial_bold"
                    android:layout_below="@id/even_view4"
                    android:textFontWeight="450"/>
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/round_img"
                    android:layout_alignEnd="@id/happyText5"
                    android:layout_alignBottom="@id/happyText5"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_upcoming_event"
                    android:layout_width="match_parent"
                    android:layout_below="@+id/happyText5"
                    android:layout_height="wrap_content"></androidx.recyclerview.widget.RecyclerView>

            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/relativeLayout3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/relativeLayout2"
                android:layout_marginVertical="20dp"
                android:layout_marginHorizontal="10dp">
                <ImageView
                    android:layout_width="120sp"
                    android:layout_height="200dp"
                    android:src="@drawable/color_img" />
                <ImageView
                    android:layout_width="120sp"
                    android:layout_height="200dp"
                    android:src="@drawable/color_img2"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="10dp"/>
                <ImageView
                    android:layout_width="120sp"
                    android:layout_height="200dp"
                    android:src="@drawable/color_img2"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="10dp"/>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/happyLayout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="15dp"
                android:layout_below="@id/relativeLayout3"
                >
                <TextView
                    android:id="@+id/even_view3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Events"
                    android:textColor="#000000"
                    android:fontFamily="@font/uni_neue_trial_bold"
                    android:textSize="15sp"
                    />
                <TextView
                    android:id="@+id/happyText3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/uni_neue_trial_bold"
                    android:text="All About Music"
                    android:textColor="#FE4164"
                    android:textSize="15sp"
                    android:layout_below="@id/even_view3"
                    android:textFontWeight="450"/>
                <ImageView
                    android:id="@+id/round_img3"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/round_img"
                    android:layout_alignEnd="@id/happyText3"
                    android:layout_alignBottom="@id/happyText3"/>
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_all_event_music"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/happyLayout2"

                ></androidx.recyclerview.widget.RecyclerView>




        </RelativeLayout>
    </ScrollView>

</RelativeLayout>