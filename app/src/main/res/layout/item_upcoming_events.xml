<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/_70sdp"
                android:layout_height="@dimen/_60sdp"
                app:cardCornerRadius="@dimen/_10sdp"
                >
                <ImageView
                    android:id="@+id/img_event"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="7dp">
                <TextView
                    android:id="@+id/month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jan"
                    android:textColor="#000000"
                    android:fontFamily="@font/unineue_trial_regular"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="02"
                    android:textColor="#02DABD"
                    android:fontFamily="@font/uni_neue_trial_bold"
                    android:layout_weight="1200"
                    android:textSize="20sp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sun"
                        android:fontFamily="@font/unineue_trial_regular"
                        android:textColor="#000000"
                        android:textSize="11sp"/>
                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/person_icon"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="5dp">
                <LinearLayout
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/clock_icon"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/unineue_trial_regular"

                        android:text="9:30 to 10:30"
                        android:textColor="#290347"
                        android:textSize="7sp"
                        android:layout_marginStart="7dp"/>

                </LinearLayout>
                <TextView
                    android:id="@+id/txt_event_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MEGA Event"
                    android:textSize="13sp"
                    android:layout_below="@id/time"
                    android:fontFamily="@font/uni_neue_trial_bold"
                    android:layout_weight="4500"
                    android:textColor="#290347"/>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txt_event_name"
                    >
                    <TextView
                        android:id="@+id/people2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25 People attending"
                        android:fontFamily="@font/unineue_trial_regular"

                        android:textSize="10sp"
                        android:textColor="#454B54"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="22dp"
                        />
                    <ImageView
                        android:id="@+id/heart2"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/heart_img"
                        android:layout_toRightOf="@id/people2"
                        android:layout_alignBottom="@id/people2"
                        android:layout_marginStart="20dp"/>
                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/share_logo"
                        android:layout_alignParentEnd="true"
                        android:layout_alignBottom="@id/people2"
                        android:layout_marginEnd="6dp"/>
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>


</LinearLayout>