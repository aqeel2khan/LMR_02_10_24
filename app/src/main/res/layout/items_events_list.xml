<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"

    >
    <com.google.android.material.card.MaterialCardView
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        app:strokeWidth="1dp"
        app:strokeColor="@color/gray_border_color"
        app:cardCornerRadius="@dimen/_12sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_margin="@dimen/_5sdp"
        >
        <RelativeLayout
            android:id="@+id/boxlayout"
            android:layout_width="match_parent"
            android:layout_height="188dp"

            >
            <ImageView
                android:id="@+id/ivToday1"
                android:layout_width="match_parent"
                android:layout_height="110dp"

                android:scaleType="fitXY"
                android:layout_marginRight="2dp"
                />
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/userimg"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/boy_img"
                android:layout_below="@id/ivToday1"
                android:layout_marginStart="15dp"
                android:layout_marginTop="-20dp"/>
            <LinearLayout
                android:id="@+id/dateLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@id/userimg"
                android:layout_marginTop="3dp"
                android:layout_marginStart="15dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jan"
                        android:fontFamily="@font/unineue_trial_regular"
                        android:textColor="#000000"
                        android:textSize="8sp"/>
                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01"
                        android:textColor="#000000"

                        android:fontFamily="@font/unineue_trial_bold"
                        android:layout_weight="600"
                        android:textSize="17sp"/>
                    <TextView
                        android:id="@+id/day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sun"
                        android:fontFamily="@font/unineue_trial_regular"
                        android:textColor="#000000"
                        android:textSize="8sp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="3dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txt_event_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Portrait Photography Event"
                        android:fontFamily="@font/unineue_trial_bold"
                        android:textColor="#290347"

                        android:textSize="12sp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">
                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/clock_icon"/>
                        <TextView
                            android:id="@+id/txt_event_start_end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="9:30 to 10:30"
                            android:textColor="#290347"
                            android:fontFamily="@font/unineue_trial_regular"

                            android:textSize="7sp"
                            android:layout_marginStart="3dp"/>

                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/heart_img"/>
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/share_logo"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>



</LinearLayout>